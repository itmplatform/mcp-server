# -- Common --
ITM_API_URL=http://localhost/ITM.API
LOG_LEVEL=info

# -- Stdio mode (AI client spawns the server as a local process) --
# Required for stdio. Not needed for HTTP+OAuth.
ITM_COMPANY=your-account
# Use ONE of:
ITM_API_KEY=your-api-key-here
# ITM_TOKEN=your-session-token-here

# -- HTTP mode --
# PORT=6170

# -- HTTP + OAuth (deployed/production) --
# When both are set, OAuth is mandatory per session.
# ITM_COMPANY and ITM_API_KEY are NOT required in this mode.
# ITM_AUTH_URL=http://localhost/ITM.API
# ITM_AUTH_PUBLIC_URL=https://api.itmplatform.com  # Public OAuth URL for AI clients (falls back to ITM_AUTH_URL)
# MCP_SERVER_URL=http://localhost:6170

# -- Audit (optional) --
# ITM_AUDIT_ENABLED=true

# -- UI deep links (optional) --
# When set, create_project includes a uiUrl link to open the project in the ITM Platform UI.
# ITM_UI_URL=https://app.itmplatform.com
