{
  "name": "@itm-platform/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for ITM Platform",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-server": "bin/mcp-server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itmplatform/mcp-server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "cross-env PORT=6170 node --env-file=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "pino-roll": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
